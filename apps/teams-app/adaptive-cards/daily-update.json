{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Daily project update",
      "weight": "Bolder",
      "size": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Record evidence for one work item. Your update remains editable until weekly confirmation.",
      "wrap": true
    },
    {
      "type": "Input.Text",
      "id": "workItemId",
      "label": "Work item ID",
      "isRequired": true,
      "errorMessage": "Work item ID is required"
    },
    {
      "type": "Input.ChoiceSet",
      "id": "status",
      "label": "Status",
      "value": "IN_PROGRESS",
      "choices": [
        { "title": "Not started", "value": "NOT_STARTED" },
        { "title": "In progress", "value": "IN_PROGRESS" },
        { "title": "Blocked", "value": "BLOCKED" },
        { "title": "Ready for review", "value": "READY_FOR_REVIEW" },
        { "title": "Done", "value": "DONE" }
      ]
    },
    {
      "type": "Input.Text",
      "id": "workSummary",
      "label": "Work summary",
      "isMultiline": true,
      "isRequired": true,
      "errorMessage": "Work summary is required"
    },
    {
      "type": "Input.Text",
      "id": "blocker",
      "label": "Blocker (optional)",
      "isMultiline": true
    },
    {
      "type": "Input.Text",
      "id": "nextAction",
      "label": "Next action",
      "isRequired": true,
      "errorMessage": "Next action is required"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Save update",
      "data": {
        "action": "dailyReport.submit",
        "schemaVersion": 1
      }
    }
  ]
}
