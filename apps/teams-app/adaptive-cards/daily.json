{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Daily project update",
      "weight": "Bolder",
      "size": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "The submission time and reporting date are recorded automatically.",
      "wrap": true,
      "isSubtle": true
    },
    {
      "type": "Input.ChoiceSet",
      "id": "projectId",
      "label": "Project",
      "isRequired": true,
      "errorMessage": "Select a project",
      "choices.data": {
        "type": "Data.Query",
        "dataset": "projects"
      }
    },
    {
      "type": "Input.Text",
      "id": "workItemId",
      "label": "Work item",
      "isRequired": true,
      "errorMessage": "Work item is required"
    },
    {
      "type": "Input.ChoiceSet",
      "id": "status",
      "label": "Status",
      "value": "IN_PROGRESS",
      "choices": [
        { "title": "Not started", "value": "NOT_STARTED" },
        { "title": "In progress", "value": "IN_PROGRESS" },
        { "title": "Blocked", "value": "BLOCKED" },
        { "title": "Ready for review", "value": "READY_FOR_REVIEW" },
        { "title": "Done", "value": "DONE" }
      ]
    },
    {
      "type": "Input.Text",
      "id": "workSummary",
      "label": "Work summary",
      "isMultiline": true,
      "isRequired": true,
      "errorMessage": "Work summary is required"
    },
    {
      "type": "Input.Text",
      "id": "blocker",
      "label": "Blocker (optional)",
      "isMultiline": true
    },
    {
      "type": "Input.Text",
      "id": "nextAction",
      "label": "Next action",
      "isRequired": true,
      "errorMessage": "Next action is required"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Save update",
      "verb": "daily",
      "data": { "action": "daily", "schemaVersion": 1 }
    }
  ]
}
