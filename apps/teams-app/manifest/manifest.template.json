{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.23/MicrosoftTeams.schema.json",
  "manifestVersion": "1.23",
  "version": "1.0.0",
  "id": "__TEAMS_APP_ID__",
  "developer": {
    "name": "VSF",
    "websiteUrl": "https://__APP_HOSTNAME__",
    "privacyUrl": "https://__APP_HOSTNAME__/privacy",
    "termsOfUseUrl": "https://__APP_HOSTNAME__/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Project Assistant",
    "full": "Project Assistant for Microsoft Teams"
  },
  "description": {
    "short": "Daily project updates and human-reviewed weekly reports.",
    "full": "Capture daily work evidence, monitor blockers and reporting coverage, and create reviewable weekly project reports from Microsoft Teams."
  },
  "accentColor": "#0369A1",
  "staticTabs": [
    {
      "entityId": "project-assistant-home",
      "name": "Project Assistant",
      "contentUrl": "https://__APP_HOSTNAME__/",
      "websiteUrl": "https://__APP_HOSTNAME__/",
      "scopes": ["personal"]
    }
  ],
  "bots": [
    {
      "botId": "__TEAMS_APP_ID__",
      "scopes": ["personal", "groupChat", "team"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "groupChat", "team"],
          "commands": [
            { "title": "help", "description": "Show actions available to your role" },
            { "title": "daily", "description": "Submit a structured daily update" },
            { "title": "history", "description": "View your daily report history" },
            { "title": "daily-summary", "description": "View Team reporting coverage and blockers" },
            { "title": "weekly", "description": "Generate your weekly report draft" },
            { "title": "weekly-team", "description": "Generate a Team weekly report draft" }
          ]
        },
        {
          "scopes": ["personal"],
          "commands": [
            { "title": "weekly-multi-team", "description": "Generate a multi-Team weekly report draft" }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["__APP_HOSTNAME__"],
  "webApplicationInfo": {
    "id": "__TEAMS_APP_ID__",
    "resource": "api://__APP_HOSTNAME__/__TEAMS_APP_ID__"
  }
}
